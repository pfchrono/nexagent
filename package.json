{
  "name": "nexagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nexagent": "./dist/nexagent-linux-x64"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "test": "bun test ./test/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "dev:opentui": "bun run src/cli.ts --opentui",
    "compile": "bun run compile:linux && bun run compile:macos && bun run compile:windows",
    "compile:linux": "bun build ./src/cli.ts --compile --outfile ./dist/nexagent-linux-x64 --target=bun-linux-x64",
    "compile:macos": "bun build ./src/cli.ts --compile --outfile ./dist/nexagent-darwin-arm64 --target=bun-darwin-arm64",
    "compile:windows": "bun build ./src/cli.ts --compile --outfile ./dist/nexagent-windows-x64.exe --target=bun-windows-x64"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@openrouter/agent": "^0.4.0",
    "@opentui/core": "^0.2.0",
    "@opentui/react": "^0.2.0",
    "@types/react": "^19.2.14",
    "diff": "^9.0.0",
    "eslint": "^10.2.1",
    "fast-glob": "^3.3.3",
    "get-shit-done-cc": "^1.38.3",
    "ignore": "^7.0.5",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "simple-git": "^3.36.0",
    "slice-ansi": "^9.0.0",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0",
    "ts-morph": "^28.0.0",
    "typescript-eslint": "^8.59.1",
    "wrap-ansi": "^10.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
