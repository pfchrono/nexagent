{
  "name": "nexagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nexagent": "./dist/nexagent-linux-x64"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "test": "bun test ./test/*.test.ts",
    "start": "node --import ./dist/instrument.js dist/cli.js",
    "dev": "bun run src/cli.ts",
    "dev:opentui": "bun run src/cli.ts --opentui",
    "compile": "bun run scripts/compile.ts",
    "compile:linux": "bun run scripts/compile.ts linux",
    "compile:macos": "bun run scripts/compile.ts macos",
    "compile:windows": "bun run scripts/compile.ts windows",
    "compile:dev:linux": "bun run scripts/compile.ts dev:linux",
    "compile:linux:dev": "bun run scripts/compile.ts linux:dev"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-language-server": "^5.1.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@openrouter/agent": "^0.4.0",
    "@opentui/core": "^0.2.0",
    "@opentui/react": "^0.2.0",
    "@sentry/node": "^10.51.0",
    "@types/react": "^19.2.14",
    "diff": "^9.0.0",
    "eslint": "^10.2.1",
    "fast-glob": "^3.3.3",
    "get-shit-done-cc": "^1.38.3",
    "ignore": "^7.0.5",
    "p-limit": "^7.3.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "shell-quote": "^1.8.3",
    "simple-git": "^3.36.0",
    "slice-ansi": "^9.0.0",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0",
    "ts-morph": "^28.0.0",
    "typescript-eslint": "^8.59.1",
    "wrap-ansi": "^10.0.0",
    "zod": "^4.4.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
